# Adres i klucz anonimowy lokalnego Supabase.
# `pnpm db:env` zapisuje tu wartości wypisane przez `pnpm db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Adres, spod którego podawany jest Widget. Konfiguracja platformy, nie
# Strzelnicy: z niego Panel składa znacznik osadzenia do skopiowania. Ta sama
# wartość, co `WIDGET_ORIGIN` w `supabase/config.toml` — tamtą czytają Edge
# Functions. Lokalnie dopisuje ją `pnpm db:env`.
VITE_WIDGET_ORIGIN=http://localhost:5173

# Klucz serwisowy lokalnego Supabase. Używają go wyłącznie testy przeglądarkowe:
# czytają nim przechwyconą pocztę i przesuwają termin wygaśnięcia Rezerwacji.
# Żadna aplikacja go nie widzi — Vite wystawia tylko zmienne z przedrostkiem VITE_.
SUPABASE_SERVICE_ROLE_KEY=
