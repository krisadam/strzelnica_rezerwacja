# Adres i klucz anonimowy lokalnego Supabase.
# `pnpm db:env` zapisuje tu wartości wypisane przez `pnpm db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Klucz serwisowy lokalnego Supabase. Używają go wyłącznie testy przeglądarkowe:
# czytają nim przechwyconą pocztę i przesuwają termin wygaśnięcia Rezerwacji.
# Żadna aplikacja go nie widzi — Vite wystawia tylko zmienne z przedrostkiem VITE_.
SUPABASE_SERVICE_ROLE_KEY=
